# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# macOS / 编辑器自动生成
.DS_Store

# Virtual environments
.venv
.claude
.agents
.workbuddy

# Secrets — never commit API keys
.env
.env.*
!.env.example
conf/config.toml

# MCP 服务器配置：机器相关，而且 stdio 服务器会在启动时执行命令——
# 按需从 conf/mcp.example.json 复制，不要默认入库
conf/mcp.json

# langgraph dev 的运行状态目录（工作空间下；scode 不再清理它——
# 里面的 .langgraph_ops.pckl 是 thread 索引，删了重启后会话列表就空了；
# 直接手动跑 langgraph dev 或在后端目录运行时也会出现，一并忽略）
.langgraph_api/

# SQLite 持久化数据（checkpoint + store）
stupid_code/data/

# agent 长期记忆（工作空间本地状态文件，点开头不进版本库）
.scode-memory.md

# agent 自己的中间产物（工作空间本地状态，点开头不进版本库）：
#   .scode/conversation_history/   压缩对话历史时被摘走的旧消息
#   .scode/large_tool_results/    太大的工具结果（deepagents 的 eviction）
#   .scode/blobs/                 二进制内容块（默认关着）
# agent 需要时可以用 read_file 读回来，所以必须留在工作空间里。
.scode/

# 压缩对话历史时被摘走的旧消息（deepagents 落到 backend 的文件里，
# agent 需要时可以用 read_file 读回来）——同样是工作空间本地状态。
# 旧路径：artifacts_root 收拢到 /.scode 之前留下的，给已有工作空间兜底。
conversation_history/


