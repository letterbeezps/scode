# 前端镜像的构建上下文排除项。

node_modules
dist
dist-ssr

# 本地环境覆盖文件不进镜像：容器里的构建参数由 Dockerfile 显式注入，
# 宿主机的 .env.local 不该影响镜像产物。
.env
.env.*
!.env.example
*.local

# 版本控制 / 编辑器
.git
.gitignore
.DS_Store
.vscode
.idea

# 日志
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Docker 自身
Dockerfile
.dockerignore
