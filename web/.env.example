# 复制为 .env.local 后按需修改（.env.local 不会被提交）

# 后端 LangGraph API Server 地址。
# 开发态默认 http://localhost:2024（`langgraph dev`），由 Vite 代理 /api 过去。
# 生产构建走静态托管时，把它改成后端的完整地址，例如 https://api.example.com
VITE_LANGGRAPH_URL=http://localhost:2024

# 前端请求前缀。留空则用相对路径 /api（走同源代理，推荐）。
# 直接跨域访问后端时才需要显式设置，并让后端放开 CORS。
# VITE_API_BASE_URL=http://localhost:2024

# LangGraph Platform 的 assistant_id，对应 langgraph.json 里的 graphs key。
VITE_ASSISTANT_ID=code_agent

# 工作空间不通过环境变量预设：用户在「工作空间」选择器里点选文件夹，
# 前端拿到绝对路径后随请求传给后端（config.configurable.workspace）。

# 生产环境鉴权用（经 Authorization: Bearer 透传）。开发环境留空。
# VITE_LANGGRAPH_API_KEY=

# true 时使用内置假数据，不连后端。后端 P0 没做完时用来演示 UI。
# 生产构建务必保持 false 或不设置。
VITE_USE_MOCK=true
